{
  "name": "burpsy-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "check:tokens": "node scripts/check-closed-tokens.mjs",
    "gen:gated-routes": "bun scripts/gen-gated-routes.ts",
    "check:gated-routes": "bun scripts/gen-gated-routes.ts --check",
    "test:scripts": "node scripts/lib/transit.test.mjs && node scripts/fetch-penpot-file.test.mjs",
    "test:lib": "bun test src/lib",
    "fetch:penpot": "node scripts/fetch-penpot-file.mjs",
    "audit:penpot": "node scripts/penpot-audit.mjs",
    "build:js": "bun build src/app.tsx --outdir dist --minify",
    "build:css": "bun build src/styles.css --outfile style.css --minify",
    "build": "bun run gen:tokens && bun run build:js && bun run build:css",
    "check": "tsc --noEmit && node scripts/gen-tokens.mjs --check && bun run check:tokens && bun run check:gated-routes && bun run test:scripts && bun run test:lib"
  },
  "dependencies": {
    "@codemirror/language": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@radix-ui/react-context-menu": "^2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-switch": "^1",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3",
    "@uiw/react-codemirror": "^4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5",
    "react-resizable-panels": "^4",
    "sonner": "^2",
    "zustand": "^5"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "commander": "^15.0.0",
    "mcporter": "^0.13.4",
    "typescript": "^7.0.2"
  }
}

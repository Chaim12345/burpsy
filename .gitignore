/target
**/*.rs.bk
# Runtime state and generated CA material — never commit private keys.
/ca/
*.pem
*.key
# OMC operational artifacts
# Unanchored: agents have been observed running with cwd set to a subdirectory (e.g.
# crates/web/ui/), which writes this state at that depth instead of the repo root.
.omc/

# Agent worktrees live inside the repo; they are checkouts, not content.
.claude/worktrees/
.swarm/
.worktrees/

# Researcher web-fetch cache — machine-generated, churns, not planning content.
.planning/research/.cache/

# GSD operational artifacts (runtime state, notifications) — not planning content.
# Unanchored: agents run with cwd set to a crate, so these appear at any depth.
.gsd/

# Background-shell scratch from agent runs.
.bg-shell/

# Agent tool state — index/cursor artifacts, not source. Unanchored: tools run
# from anywhere in the tree.
.codegraph/
.cursor/

# Frontend dependencies are restored from the committed Bun lockfile.
node_modules/

# Browser-suite output: 68 screenshots, the HTML report, traces and failure artifacts. All of it is
# regenerated by ./e2e-ui.sh and none of it is content — a committed screenshot is a baseline nobody
# asked for, and a committed trace is a 20MB zip. The suite's own package.json and package-lock.json
# ARE committed, so `npm ci` in that directory is reproducible.
burpsy-go/internal/web/ui/e2e/artifacts/

# generated by: mcporter generate-cli --server openpencil --name openpencil --output ./openpencil-cli
burpsy-go/internal/web/ui/scripts/openpencil-cli
